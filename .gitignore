# 依赖
node_modules/

# 构建产物
dist/
*.exe
*.dmg
*.apk
*.ipa
*.app
*.blockmap

# TypeScript 编译产物（源码为同名 .ts，由 npm run build 生成）
/src/*.js
/electron/*.js

# Electron 二进制缓存
.electron-cache/

# Capacitor 原生工程（cap add 生成，可重新生成，体积大）
capacitor/android/
capacitor/ios/

# IDE 本地配置与工具链状态
.trae/
.vscode/
.idea/
.vs/
*.code-workspace

# Python 虚拟环境与字节码缓存
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]

# 环境变量与签名密钥（防止敏感信息泄漏）
.env
.env.local
*.pem
*.keystore
*.jks
*.p12

# 操作系统文件与临时文件
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.tmp
*~
*.swp

# 日志与临时文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 临时验证脚本（开发期生成，不入库）
design/verify*.js

# e2e 测试生成的截图（仅本地验证用，不入库）
docs/screenshots/
