{
  // Electron 宿主（electron/）：Node + CommonJS，产物 .js 就地回写到 electron/，
  // 因此 package.json 的 main 与 BrowserWindow 的 preload 路径都无需改动。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true
  },
  "include": ["electron/**/*.ts", "types/**/*.d.ts"]
}
